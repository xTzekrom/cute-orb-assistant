<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hookspike.ai">

    <!-- Screen ke upar Orb dikhane ke liye -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Background me service chalane ke liye -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Backend server se connect hone ke liye -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="HookSpike AI"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Background Floating Orb Service -->
        <service
            android:name=".FloatingOrbService"
            android:enabled="true"
            android:exported="false" />

        <!-- App Launcher Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
